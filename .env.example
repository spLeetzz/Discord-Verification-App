# Copy to .env and fill in. Never commit the real .env.

# --- Discord ---
BSSA_DISCORD_BOT_TOKEN=
# For a bot, the application id equals the bot user id.
BSSA_CLIENT_ID=
# Only interactions from this guild are handled. Leave empty to handle all.
ALLOWED_GUILD_ID=
# Where slash commands are registered (guild-scoped).
GUILD_ID=

# --- Google Sheets (existing verification flow) ---
# Absolute path to the service-account JSON, or use GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_KEY_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
SPREADSHEET_ID=

# --- Free Fire event ---
FREE_FIRE_SPREADSHEET_ID=
FREE_FIRE_CHANNEL_ID=
FREE_FIRE_BACKUP_CHANNEL_ID=
FREE_FIRE_ROLE_ID=

# --- Postgres (docker compose service "postgres") ---
DATABASE_URL=postgres://bssa:bssa@localhost:5433/bssa
POSTGRES_USER=bssa
POSTGRES_PASSWORD=bssa
POSTGRES_DB=bssa
POSTGRES_PORT=5433

# --- Dashboard (port from Quotient) ---
DASHBOARD_PORT=8888
DASHBOARD_SECRET=change-me

# --- Premium checkout (PayU) ---
# The merchant key and salt PayU signs with. The salt and key are SWAPPED
# between the request hash and the response hash.
PAYU_KEY=
PAYU_SALT=
# The publicly reachable base URL of the payment server, e.g.
# https://bot.example.com — PayU redirects the buyer back to it.
PREMIUM_PUBLIC_URL=
PREMIUM_PORT=8890

# --- OCR (screenshot verification) ---
# There is no local OCR engine: the remote service does the text recognition
# and the hashing. Without it every screenshot is refused.
# The Quotient-compatible remote OCR service.
OCR_PROVIDER_URL=
# Optional: sent in the `authorization` header.
OCR_PROVIDER_KEY=
# true forces OCR on, false forces it off. Unset = automatic: OCR runs only
# when a screenshot-verification setup exists. When OCR is off, screenshots
# are rejected rather than waved through.
OCR_ENABLED=

# --- Database ---
# The driver, and the database file. The file must live OUTSIDE the release
# directory, or it is deleted on every deploy.
DB_DRIVER=sqlite
DB_FILE=file:./data/quotient.db

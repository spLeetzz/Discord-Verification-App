{
  "name": "discord-verification-app",
  "version": "1.0.0",
  "description": "Discord ticket-based verification bot for esports event registrations.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "serve": "npm run build && node dist/main.js",
    "dev": "tsx watch main.ts",
    "deploy": "tsx deploy.ts",
    "deploy:prod": "npm run build && node dist/deploy.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "smoke": "tsx scripts/smoke.ts",
    "test:mentions": "tsx scripts/integration-mentions.ts",
    "clean": "rm -rf dist",
    "boot:check": "tsx scripts/boot-check.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "@fastify/session": "^11.1.5",
    "@fastify/static": "^10.1.6",
    "chrono-node": "^2.10.3",
    "croner": "^10.0.1",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "googleapis": "^171.4.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
